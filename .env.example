DATABASE_URL=sqlite:///./owl_plate.db
API_PORT=8017
WEB_PORT=3017
AUTH_MODE=demo
DEMO_MODE=true
VISION_PROVIDER=fixture
NOTIFICATION_PROVIDER=log
GEMINI_API_KEY=
GEMINI_MODEL=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
PUSH_TOKEN_ENCRYPTION_KEY=
FCM_ALLOWED_STUDENT_IDS=
NEXT_PUBLIC_API_URL=http://localhost:8017
NEXT_PUBLIC_UI_FIXTURE_MODE=false
NEXT_PUBLIC_FIREBASE_CONFIG=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# It site origin printed by `it site --no-open`; public URL, no credentials.
NEXT_PUBLIC_IT_COMPANION_BASE_URL=
CORS_ORIGINS=http://localhost:3017
ENTRA_CLIENT_ID=
ENTRA_ALLOWED_TENANT_ID=
# Fixed v1 timings (not environment settings): invite 60s demo / 90s production,
# claim hold 600s, scheduler tick 10s. See docs/API_CONTRACT.md.
# Photos are processed in memory and never retained; a storage adapter must enforce <=24h expiry.
# Phone/HTTPS builds: set NEXT_PUBLIC_API_URL=/backend and OWL_API_ORIGIN to the API origin.
OWL_API_ORIGIN=http://127.0.0.1:8017
# Open anonymous collection only after the form/sharing plan is approved.
SURVEY_ENABLED=false
