# Vercel project root: apps/web. No secret values go in Git.
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_UI_FIXTURE_MODE=false
# Set BEFORE web build; requires the selected API's assigned HTTPS origin.
OWL_API_ORIGIN=https://API-HOST-TO-BE-APPROVED.invalid

# API service private environment (PostgreSQL required on the deployment target).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB-HOST/owl_plate
AUTH_MODE=demo
DEMO_MODE=true
VISION_PROVIDER=fixture
NOTIFICATION_PROVIDER=log
# Keep false until Johaan approves the form and direct-sharing plan.
SURVEY_ENABLED=false
CORS_ORIGINS=https://WEB-HOST-TO-BE-APPROVED.invalid
